<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- XML yorumları Swagger arayüzünde endpoint açıklaması olarak görünür. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="1.6.22" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- API, Service'e (iş mantığı) ve Data'ya (yalnızca bağımlılık kaydı ve geliştirme tohum verisi için,
         yani "composition root" görevi) bağlıdır. Controller'lar Data'yı doğrudan kullanmaz. -->
    <ProjectReference Include="..\IskurAuto.Service\IskurAuto.Service.csproj" />
    <ProjectReference Include="..\IskurAuto.Data\IskurAuto.Data.csproj" />
  </ItemGroup>

</Project>
