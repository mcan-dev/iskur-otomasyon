{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IskurAutoDb": "Data Source=iskurauto.db"
  },
  "JwtSettings": {
    "SecretKey": "CHANGE-THIS-TO-A-STRONG-SECRET-KEY-AT-LEAST-32-CHARS",
    "Issuer": "IskurAutoAPI",
    "Audience": "IskurAutoClients",
    "ExpirationMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Storage": {
    "DocumentsPath": "App_Data/documents"
  },
  "WorkPlan": {
    "MinDaysPerWeek": 1,
    "MaxDaysPerWeek": 3,
    "EditDeadlineDay": 5,
    "FullDayHours": 8
  },
  "Bootstrap": {
    "AdminEmail": "",
    "AdminPassword": ""
  }
}
